{
  "name": "umakuma",
  "version": "0.224.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-6400}",
    "dev:6400": "next dev -p 6400",
    "dev:local": "node scripts/local-db.mjs run -- next dev -p 6400",
    "dev:staging": "node scripts/local-db.mjs run --staging -- next dev -p ${STAGING_WEB_PORT:-6402}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-6400}",
    "start:6400": "next start -p 6400",
    "test:smoke:local": "PLAYWRIGHT_BASE_URL=http://localhost:${WEB_PORT:-6400} playwright test -c playwright.smoke.local.config.ts",
    "test:responsive": "PLAYWRIGHT_BASE_URL=http://localhost:${WEB_PORT:-6400} playwright test -c playwright.responsive.config.ts",
    "test:smoke:build": "pnpm build && PLAYWRIGHT_BASE_URL=http://127.0.0.1:6401 playwright test -c playwright.smoke.build.config.ts",
    "test:smoke:install": "playwright install chromium",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "constants:check": "node scripts/check-component-constants.mjs",
    "study:magic-check": "node scripts/check-study-magic-strings.mjs",
    "level:magic-check": "node scripts/check-level-magic-strings.mjs",
    "loc:check": "node scripts/check-max-loc.mjs",
    "security:check": "pnpm audit --prod --audit-level high",
    "quality:check": "pnpm lint && pnpm constants:check && pnpm study:magic-check && pnpm level:magic-check && pnpm loc:check && pnpm typecheck && pnpm test:unit",
    "quality:fix": "pnpm lint:fix && pnpm quality:check",
    "preflight:prod": "pnpm quality:check && pnpm security:check && pnpm build",
    "deploy:push": "git push origin main",
    "deploy:status": "npx --yes vercel@57.0.0 ls umakuma",
    "deploy:status:latest": "npx --yes vercel@57.0.0 ls umakuma | rg -o 'https://umakuma-[^[:space:]]+' -m1 | xargs -I{} npx --yes vercel@57.0.0 inspect {}",
    "deploy:prod": "pnpm preflight:prod && npx --yes vercel@57.0.0 --prod --yes",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:drift:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code --script",
    "db:studio": "prisma studio",
    "db:backfill:reading-challenge": "node scripts/backfill-reading-challenge-ids.mjs",
    "db:backfill:custom-study": "pnpm dlx tsx scripts/backfill-custom-study-enrichment.ts",
    "db:bootstrap:wk-catalog": "NODE_OPTIONS='--conditions=react-server' pnpm dlx tsx scripts/bootstrap-wk-catalog.ts",
    "db:sync:wk-catalog": "NODE_OPTIONS='--conditions=react-server' pnpm dlx tsx scripts/sync-wk-catalog-incremental.ts",
    "db:backfill:wk-catalog": "NODE_OPTIONS='--conditions=react-server' pnpm dlx tsx scripts/backfill-wk-catalog-missing.ts",
    "db:export:wk-catalog:levels": "pnpm dlx tsx scripts/export-wk-catalog-level-json.ts",
    "db:seed:jlpt": "node scripts/seed-jlpt.mjs",
    "db:seed:jlpt:readings": "node scripts/build-jlpt-readings.mjs",
    "db:seed:kanji-levels": "node scripts/build-kanji-levels.mjs",
    "db:build:school-grades": "node scripts/build-school-grade-kanji.mjs",
    "db:seed:school-grades": "NODE_OPTIONS='--conditions=react-server' pnpm dlx tsx scripts/seed-school-grade-kanji.ts",
    "map:build": "node scripts/build-geo-jp-map.mjs",
    "map:build:meta": "node scripts/build-geo-jp-meta.mjs",
    "map:build:us": "node scripts/build-geo-us.mjs",
    "map:build:canada": "node scripts/build-geo-ca.mjs",
    "map:build:all": "node scripts/build-geo-jp-map.mjs && node scripts/build-geo-jp-meta.mjs && node scripts/build-geo-us.mjs && node scripts/build-geo-ca.mjs",
    "db:enrich:jlpt": "pnpm dlx tsx scripts/enrich-jlpt-kanji.ts",
    "db:backfill:jlpt-word-kanji": "pnpm dlx tsx scripts/backfill-jlpt-word-example-kanji.ts",
    "db:backfill:jlpt-word-kanji:dry": "pnpm db:backfill:jlpt-word-kanji --dry-run",
    "test-account:run": "NODE_OPTIONS='--conditions=react-server' pnpm dlx tsx scripts/automate-test-account.ts",
    "test-members": "NODE_OPTIONS='--conditions=react-server' node scripts/local-db.mjs run -- pnpm dlx tsx scripts/seed-test-members.ts",
    "test:news:candidates": "node scripts/news-candidate-analysis.mjs",
    "db:backup": "node scripts/local-db.mjs backup",
    "local:db:up": "node scripts/local-db.mjs up",
    "local:db:down": "node scripts/local-db.mjs down",
    "local:db:reset": "node scripts/local-db.mjs reset",
    "local:db:restore": "node scripts/local-db.mjs restore",
    "local:db:push": "node scripts/local-db.mjs push",
    "local:db:psql": "node scripts/local-db.mjs psql",
    "local:seed": "NODE_OPTIONS='--conditions=react-server' node scripts/local-db.mjs run -- pnpm dlx tsx scripts/seed-local-test-user.ts",
    "staging:link": "node scripts/local-db.mjs link",
    "staging:pull": "node scripts/local-db.mjs pull",
    "staging:psql": "node scripts/local-db.mjs psql --staging",
    "staging:status": "./deploy/staging/deploy-staging-ds1.sh --status",
    "strokes:build": "node scripts/build-kanjivg.mjs",
    "kanji:build": "node scripts/build-kanjidic.mjs",
    "sentences:ingest": "pnpm dlx tsx scripts/ingest-tatoeba.ts",
    "sentences:ingest:dry": "pnpm sentences:ingest --dry-run",
    "readings:build": "node scripts/build-joyo-readings.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6.19.3",
    "jsdom": "^29.0.2",
    "kuromoji": "^0.1.2",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "wanakana": "^5.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.1",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0",
      "eslint-plugin-react-hooks": "7.0.1",
      "nanoid": "^3.3.17",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "undici": "^7.28.0"
    }
  }
}
