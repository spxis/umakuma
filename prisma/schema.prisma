generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String    @id @default(cuid())
  nickname                 String
  /**
   * The address, and the name, which are not the same thing.
   * `slug` is unique and permanent: it is in every link anyone has shared, so
   * renaming must not touch it. `displayName` is what people read, anyone can
   * change it, and two members may share one. Both are nullable while existing
   * accounts are still routed by wkUsername.
   */
  slug                     String?   @unique
  displayName              String?
  /**
   * JLPT certification, as the member reports it.
   * Self-declared, unlike wkLevel which WaniKani decides. The system matters
   * as much as the level: the test was restructured in 2010 and both schemes
   * count down, so an old Level 4 is the beginner certificate and maps to N5,
   * not N4. Stored as given and converted for display.
   */
  jlptStatus               String?
  /**
   * The single certificate a member used to be allowed.
   * A member may hold several - somebody who sat N5, then N4, then N3 holds
   * three - so what they have passed lives in `JlptCertificate` rows now, and
   * these three columns are the answer given before that table existed. They
   * were migrated into rows and nothing reads them; they are kept because the
   * data outlives the code, not because anything still asks. `jlptStatus`
   * above is still live: it carries the states that are not a certificate at
   * all - studying, planning to sit, none, rather not say.
   */
  jlptSystem               String?
  jlptLevel                Int?
  jlptYear                 Int?
  /**
   * Who may see this member, and whether they are let in at all.
   * `visibility` is the member's own choice, asked during signup and editable
   * on their profile: private, family (other members) or public. Null means an
   * account that predates the column, which was already on the leaderboard and
   * must stay there, so it reads as family rather than private.
   * `approvalStatus` is John's decision, not theirs. Open Google signup lets
   * anyone create an account, but it stays pending until approved, so a
   * stranger can look around without appearing anywhere.
   */
  visibility               String?
  approvalStatus           String?
  approvedAt               DateTime?
  /**
   * Switched off by an admin, and why, and by whom.
   * Not `approvalStatus`, deliberately. Rejection answers "should this person
   * be let in", asked once at the door, and `approvedAt` is the record of that
   * answer. Disabling happens to somebody already inside - an account being
   * reissued, a member who asked for a break, an abuse report being looked at
   * - and it has to be reversible without rewriting the approval history.
   * Overloading `rejected` would have made re-enabling indistinguishable from
   * approving, and would have told an established member on their own page
   * that they were never let in.
   * Null means enabled: a column added under existing rows must not switch
   * anybody off, and the absence of a timestamp is the honest way to say
   * nobody has ever done this. The reason is for the admin reading the account
   * back in a month, not for the member.
   */
  disabledAt               DateTime?
  disabledReason           String?
  disabledBy               String?
  joinedByEmail            String?
  joinedByName             String?
  inviteCodeHash           String?
  inviteCodeUpdatedAt      DateTime?
  /**
   * The WaniKani connection, which an account may not have.
   * Identity is the account; this is a link on it. All six move together -
   * a half-connected account is not a state worth modelling, so code should
   * test one of them (the token) and treat the rest as present or absent with
   * it. Nullable `wkUserId` keeps its unique index: Postgres does not compare
   * nulls, so any number of unconnected accounts coexist.
   */
  tokenEncrypted           String?
  tokenIv                  String?
  tokenTag                 String?
  wkUserId                 String?   @unique
  wkUsername               String?
  wkLevel                  Int?
  reviewCount              Int       @default(0)
  burnedCount              Int       @default(0)
  pendingReviews           Int       @default(0)
  radicalCount             Int       @default(0)
  vocabularyCount          Int       @default(0)
  apprenticeCount          Int       @default(0)
  guruCount                Int       @default(0)
  masterCount              Int       @default(0)
  enlightenedCount         Int       @default(0)
  levelKanjiTotal          Int       @default(0)
  levelKanjiLearned        Int       @default(0)
  levelKanjiGuruPlus       Int       @default(0)
  levelKanjiLocked         Int       @default(0)
  estimatedHoursRemaining  Int?
  levelKanjiItems          Json?
  itemSpread               Json?
  jlptCounts               Json?
  assignmentCache          Json?
  assignmentCacheUpdatedAt DateTime?
  reviewsUpdatedAt         DateTime?
  lastRadicalGuruedAt      DateTime?
  lastKanjiGuruedAt        DateTime?
  lastVocabularyGuruedAt   DateTime?
  lastRadicalGuruedItem    Json?
  lastKanjiGuruedItem      Json?
  lastVocabularyGuruedItem Json?
  wkHttpCache              Json?
  lastActivityAt           DateTime?
  isSyncing                Boolean   @default(false)
  syncLockUntil            DateTime?
  nextSyncAllowedAt        DateTime  @default(now())
  lastSyncStatus           String    @default("idle")
  lastSyncError            String?
  score                    Int       @default(0)
  lastSyncedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customStudyLibraries      CustomStudyLibrary[]
  customStudyStates         CustomStudyState[]
  customStudyReviewAttempts CustomStudyReviewAttempt[]
  studySubjectTags          StudySubjectTag[]
  /// One of us: the family and anybody let in deliberately. Decides who is
  /// offered the reading challenge and its check-ins, which are not public.
  /// Which SRS theme names this member's stages. Null means the default.
  /// Display only: the stored stage values never change, so switching is
  /// instant and retroactive.
  srsTheme                  String?

  /// How this member chooses to study, as JSON - review order, batch size,
  /// checkpoint interval, whether lessons are held back behind a backlog.
  ///
  /// Only ergonomics and pace live here. Nothing in it can reach the level
  /// gate, and a test enforces that: UmaKuma level 40 has to mean the same
  /// thing for everybody or the badges, the leaderboard and the JLPT
  /// milestones stop meaning anything. See `srs/studyPreferences.ts`.
  studyPreferences String?

  /// under_13 | 13_17 | 18_plus. Decides which themes may be offered, since
  /// the set includes organised crime and the sex trade. Null is treated as
  /// the youngest: guessing upward is the mistake that reaches a child.
  ageBand String?

  /// Where this member stands on our hundred, materialised.
  ///
  /// Derived from `UkSrsState` by `resolveUkLevel` and written by exactly one
  /// function, `syncAccountUkLevel`. It is a copy on purpose: deriving it per
  /// render would mean reading thousands of state rows for every badge.
  ukLevel             Int                @default(1)
  /// The floor a member can never fall below. Placement, a WaniKani import, a
  /// bump-up test and an admin raise it; nothing lowers it. This is the only
  /// stored input to the level — everything else is derived, so a curriculum
  /// rebuild that moves a kanji cannot cost anybody a level.
  ukLevelFloor        Int                @default(1)
  ukPlacedAt          DateTime?
  ukPlacementSource   UkPlacementSource?
  /// Which curriculum version this member was last reconciled against.
  ukCurriculumVersion String?
  ukLevelUpdatedAt    DateTime?

  /// The second ladder: earned by turning up rather than by learning. Kept
  /// apart from ukLevel on purpose - neither can be bought with the other.
  xp                Int               @default(0)
  xpLevel           Int               @default(1)
  xpEvents          XpEvent[]
  restDays          MemberRest[]
  levelTests        LevelTest[]
  restGrants        MemberRestGrant[]
  /// While set, the member is away: the streak is held and SRS due dates move
  /// with them rather than piling up. Cleared on return, which is when the
  /// queue is shifted forward by the length of the absence.
  vacationStartedAt DateTime?
  vacationEndsAt    DateTime?

  internal               Boolean                 @default(false)
  jlptCertificates       JlptCertificate[]
  studyLists             StudyList[]
  mapRegionMarks         MapRegionMark[]
  studyListSubscriptions StudyListSubscription[]
  studyListProposals     StudyListProposal[]
  gameRuns               GameRun[]
  ukSrsStates            UkSrsState[]
  ukReviewAttempts       UkReviewAttempt[]
}

/// One JLPT certificate a member reports holding.
///
/// A row rather than three columns on the account, because a member may hold
/// several: the ladder is meant to be climbed, and somebody who sat N5, N4 and
/// N3 has three certificates rather than a current one. The year decides the
/// system - the test was restructured in 2010 - and it is stored beside the
/// level so a row reads on its own without consulting the year twice.
model JlptCertificate {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "classic" (1984-2009, levels 4-1) or "modern" (2010 on, N5-N1).
  system    String
  level     Int
  year      Int
  createdAt DateTime @default(now())

  /// The same level in the same year is the same certificate, not a second one.
  @@unique([accountId, system, level, year])
  @@index([accountId])
}

model InviteRateLimit {
  key       String   @id
  attempts  Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model LevelSnapshot {
  id                      String   @id @default(cuid())
  accountId               String
  level                   Int
  kanjiTotal              Int      @default(0)
  kanjiLearned            Int      @default(0)
  kanjiGuruPlus           Int      @default(0)
  kanjiLocked             Int      @default(0)
  estimatedHoursRemaining Int?
  items                   Json?
  syncedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([accountId, level])
  @@index([accountId])
}

model DailyAccountSnapshot {
  id                String    @id @default(cuid())
  accountId         String
  snapshotDatePst   String
  snapshotAt        DateTime  @default(now())
  wkLevel           Int
  reviewCount       Int
  burnedCount       Int
  pendingReviews    Int
  radicalCount      Int
  vocabularyCount   Int
  apprenticeCount   Int
  guruCount         Int
  masterCount       Int
  enlightenedCount  Int
  levelKanjiLearned Int
  levelKanjiTotal   Int
  score             Int
  lastActivityAt    DateTime?
  lastSyncedAt      DateTime

  @@unique([accountId, snapshotDatePst])
  @@index([accountId])
}

model JlptKanji {
  id             String    @id @default(cuid())
  kanji          String    @unique
  nLevel         Int
  strokeCount    Int?
  frequencyRank  Int?
  schoolGrade    Int?
  heisigKeyword  String?
  unicodeHex     String?
  sourceJlpt     Int?
  primaryMeaning String?
  meanings       String[]  @default([])
  onReadings     String[]  @default([])
  kunReadings    String[]  @default([])
  nanoriReadings String[]  @default([])
  notes          String[]  @default([])
  wordExamples   Json?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nLevel])
}

model SchoolGradeKanji {
  id             String   @id @default(cuid())
  kanji          String   @unique
  grade          Int
  category       String   @default("elementary")
  categoryName   String?
  categoryAbbr   String?
  strokeCount    Int?
  frequencyRank  Int?
  unicodeHex     String?
  primaryMeaning String?
  meanings       String[] @default([])
  onReadings     String[] @default([])
  kunReadings    String[] @default([])
  nanoriReadings String[] @default([])
  heisigKeyword  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([grade])
  @@index([category])
}

model WkSubjectCatalog {
  wkSubjectId               Int       @id
  object                    String    @default("subject")
  subjectType               String
  level                     Int
  slug                      String?
  characters                String?
  documentUrl               String?
  dataUpdatedAt             DateTime
  hiddenAt                  DateTime?
  meanings                  Json?
  readings                  Json?
  componentSubjectIds       Int[]     @default([])
  amalgamationSubjectIds    Int[]     @default([])
  visuallySimilarSubjectIds Int[]     @default([])
  meaningMnemonic           String?
  meaningHint               String?
  readingMnemonic           String?
  readingHint               String?
  rawData                   Json
  documentVersion           Int       @default(1)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([subjectType, level])
  @@index([level])
  @@index([dataUpdatedAt])
  @@index([hiddenAt])
}

/**
 * Admin-editable settings that are not simply on or off.
 * FeatureFlag holds booleans; this holds the rest, as strings parsed by the
 * definition in code. Same split as the flags: what settings exist and what
 * they accept lives in `src/lib/signupSettings.ts`, and the database stores
 * only the chosen values, so a setting works before any row exists and a stale
 * row for a removed setting is inert.
 */
model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WkCatalogSyncState {
  id                             String              @id @default("global")
  isSyncing                      Boolean             @default(false)
  syncLockUntil                  DateTime?
  nextSyncAllowedAt              DateTime            @default(now())
  lastStatus                     WkCatalogSyncStatus @default(idle)
  lastError                      String?
  lastFullSyncStartedAt          DateTime?
  lastFullSyncCompletedAt        DateTime?
  lastIncrementalSyncStartedAt   DateTime?
  lastIncrementalSyncCompletedAt DateTime?
  lastCursorDataUpdatedAt        DateTime?
  lastCursorSubjectId            Int?
  lastRunStats                   Json?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
}

model WkCatalogSyncRun {
  id                      String               @id @default(cuid())
  runType                 WkCatalogSyncRunType
  status                  WkCatalogSyncStatus  @default(running)
  startedAt               DateTime             @default(now())
  completedAt             DateTime?
  durationMs              Int?
  cursorFromDataUpdatedAt DateTime?
  cursorFromSubjectId     Int?
  cursorToDataUpdatedAt   DateTime?
  cursorToSubjectId       Int?
  fetchedCount            Int                  @default(0)
  upsertedCount           Int                  @default(0)
  changedCount            Int                  @default(0)
  errorCount              Int                  @default(0)
  errorMessage            String?
  stats                   Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([runType, startedAt])
  @@index([status, startedAt])
}

enum StudyReviewResult {
  correct
  wrong
  skipped
}

enum WkCatalogSyncStatus {
  idle
  running
  ok
  error
}

enum WkCatalogSyncRunType {
  full
  incremental
}

enum SubjectReviewSnapshotSource {
  sync
  ondemand
  submit
}

enum GameRunStatus {
  active
  completed
  abandoned
}

enum GameSubjectCategory {
  radical
  kanji
  vocabulary
  mixed
}

enum GameAnswerType {
  reading
  meaning
  chain
  romaji
}

/// Which side of the pair the player picks: the glyph (find) or its text (read).
enum GameDirection {
  find
  read
}

enum GameKind {
  match
  daily
  revenge
  time_attack
  shiritori
  map
  /// A level test. Appended, never reordered: these are persisted values.
  level_test
}

enum ReadingChallengeStatus {
  draft
  active
  completed
  archived
}

enum CustomStudySourceType {
  json_upload
}

enum CustomStudyItemType {
  kanji
  vocabulary
  phrase
}

model ReadingChallenge {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String
  status        ReadingChallengeStatus @default(draft)
  currencyCode  String                 @default("JPY")
  startDatePst  String
  goalDatePst   String
  tripDatePst   String
  targetBaseYen Int
  scoringRules  Json
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  signoffs       ReadingSignoff[]
  signoffEntries ReadingSignoffEntry[]
  books          ReadingChallengeBook[]
  members        ReadingChallengeMember[]

  @@index([status])
  @@index([startDatePst, goalDatePst])
}

model StudyReviewAttempt {
  id           String            @id @default(cuid())
  accountId    String
  assignmentId Int
  subjectId    Int
  subjectType  String
  result       StudyReviewResult
  submittedAt  DateTime          @default(now())

  @@index([accountId, subjectId, submittedAt])
  @@index([accountId, submittedAt])
}

model GameRun {
  id               String              @id @default(cuid())
  accountId        String
  kind             GameKind            @default(match)
  batchSize        Int
  level            Int?
  category         GameSubjectCategory
  hardMode         Boolean             @default(false)
  choiceCount      Int                 @default(2)
  direction        GameDirection       @default(find)
  answerMode       String              @default("auto")
  dailyKey         String?
  seed             String?
  timeLimitMs      Int?
  questionCount    Int
  answeredCount    Int                 @default(0)
  correctCount     Int                 @default(0)
  currentStreak    Int                 @default(0)
  bestStreak       Int                 @default(0)
  score            Int                 @default(0)
  durationMs       Int?
  status           GameRunStatus       @default(active)
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  completedDatePst String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  questions GameQuestion[]

  @@unique([accountId, kind, dailyKey])
  @@index([accountId, completedAt])
  @@index([status, batchSize, level, category, completedDatePst])
  @@index([kind, status, completedDatePst])
}

model GameQuestion {
  id                String         @id @default(cuid())
  runId             String
  position          Int
  targetSubjectId   Int
  leftSubjectId     Int
  middleSubjectId   Int?
  rightSubjectId    Int
  optionSubjectIds  Int[]          @default([])
  answerType        GameAnswerType
  promptOverride    String?
  selectedSubjectId Int?
  correct           Boolean?
  answeredAt        DateTime?

  run GameRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId])
}

model StudySubjectTag {
  id        String   @id @default(cuid())
  accountId String
  subjectId Int
  favorite  Boolean  @default(false)
  trouble   Boolean  @default(false)
  /// Known so well it need never be read again; hidden from every list when the member says so.
  burned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, subjectId])
  @@index([accountId, favorite])
  @@index([accountId, trouble])
  @@index([accountId, burned])
}

/// A named set of characters a member built by hand: "Week 1", "Week 2".
///
/// Characters rather than WaniKani subject ids, which is the one place this
/// differs from StudySubjectTag. A list is built on whatever surface the member
/// was looking at, and the school-grade catalogue holds kanji WaniKani does not
/// teach - keying on subject id would silently drop those from a list that
/// visibly contained them. What a list holds is its `items`, each named the
/// way its own catalogue names it, with the subject id beside it where
/// WaniKani has one.
/// What a member says about one region of one map.
///
/// Two facts, not one: whether they can name it, and whether they have been
/// there. A child can name every prefecture and have set foot in three; a
/// parent can have driven through Gifu twice and still not place it.
///
/// A row exists only while something has been said. Clearing both facts
/// deletes the row rather than storing "no opinion", so a count of what
/// somebody has marked is a count of rows.
model MapRegionMark {
  id        String   @id @default(cuid())
  accountId String
  /// The map: "JP", "US", "CA" - the dataset's own country code.
  country   String
  /// The region as its dataset names it: "3" for Iwate, "TX" for Texas.
  region    String
  /// "known" or "practice"; null when only the visit has been recorded.
  status    String?
  visited   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// One row per member per region, which is what makes a mark a toggle.
  @@unique([accountId, country, region])
  @@index([accountId, country])
}

model StudyList {
  id            String                 @id @default(cuid())
  accountId     String
  name          String
  /// The old shape: a string of characters. Nothing reads it since 0.240.0;
  /// every list's characters were copied into `items` on 2026-09-02, with a
  /// snapshot in backups/. Dropping the column is a separate, deliberate
  /// `db:push` once John says so.
  characters    String[]
  /// A line under the name, for a list that is shared.
  description   String?
  visibility    StudyListVisibility    @default(private)
  /// Unguessable, for an unlisted list: the link carries it as `?key=`.
  shareToken    String?
  /// Whether anyone may add to it, or only the owner.
  contributions StudyListContributions @default(closed)
  archivedAt    DateTime?
  /// Where a copy came from, so it can say so and pull what was added since.
  sourceListId  String?
  /// A live list this was copied from - "jlpt:n5" - when the source was a system list.
  sourceLiveKey String?
  /// When the owner marked the list done. Null while it is still being worked
  /// through. Kept rather than cleared when the list changes afterwards: that
  /// somebody finished it once is a fact, and the page says the mark is stale
  /// instead of quietly forgetting it.
  studiedAt     DateTime?
  copyCount     Int                    @default(0)
  shareCount    Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items         StudyListItem[]
  subscriptions StudyListSubscription[]
  proposals     StudyListProposal[]

  /// One name per member, so saving "Week 1" twice updates rather than forks.
  @@unique([accountId, name])
  @@index([accountId, updatedAt])
  @@index([visibility, updatedAt])
  @@index([shareToken])
}

enum StudyListVisibility {
  private
  unlisted
  public
}

enum StudyListContributions {
  closed
  open
}

/// A member keeping somebody else's list, or a live one, read-only and current.
model StudyListSubscription {
  id        String   @id @default(cuid())
  accountId String
  listId    String?
  /// A live system list - "jlpt:n5", "grade:1", "wk:12" - when there is no row to point at.
  liveKey   String?
  createdAt DateTime @default(now())

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  list    StudyList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([accountId, listId])
  @@unique([accountId, liveKey])
  @@index([listId])
}

enum StudyListProposalAction {
  add
  remove
}

enum StudyListProposalStatus {
  pending
  approved
  declined
}

/// A change somebody who is not the owner would like made to a locked list.
model StudyListProposal {
  id        String                  @id @default(cuid())
  listId    String
  accountId String
  action    StudyListProposalAction
  kind      StudyListItemKind
  key       String
  subjectId Int?
  note      String?
  status    StudyListProposalStatus @default(pending)
  createdAt DateTime                @default(now())
  decidedAt DateTime?

  list    StudyList @relation(fields: [listId], references: [id], onDelete: Cascade)
  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([listId, status])
  @@index([accountId])
}

enum StudyListItemKind {
  radical
  kanji
  vocabulary
  sentence
}

/// One thing in a saved list, with its kind.
///
/// A list was a string of characters, so it could only hold kanji and a word
/// added to it became its kanji. An item carries what it is: the key names it
/// the way its own catalogue does - the characters for a kanji or a word, the
/// WaniKani slug for a radical, Tatoeba's id for a sentence - and the subject
/// id rides along where WaniKani names it, so tags and SRS state can be found
/// without a second lookup. A kanji WaniKani does not teach has no subject id
/// and is still an item, which is what keying on characters was protecting.
model StudyListItem {
  id               String            @id @default(cuid())
  listId           String
  kind             StudyListItemKind
  key              String
  subjectId        Int?
  /// The member's order, which is the list. Gaps are fine; only the ordering counts.
  position         Int
  /// Why it is here, in the words of whoever added it.
  note             String?
  addedByAccountId String?
  createdAt        DateTime          @default(now())

  list StudyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, kind, key])
  @@index([listId, position])
}

model SubjectReviewStatsSnapshot {
  id                   String                      @id @default(cuid())
  accountId            String
  subjectId            Int
  subjectType          String
  meaningCorrect       Int
  meaningIncorrect     Int
  meaningCurrentStreak Int
  meaningMaxStreak     Int
  readingCorrect       Int
  readingIncorrect     Int
  readingCurrentStreak Int
  readingMaxStreak     Int
  percentageCorrect    Int
  capturedAt           DateTime                    @default(now())
  source               SubjectReviewSnapshotSource @default(ondemand)

  @@index([accountId, subjectId, capturedAt])
  @@index([accountId, capturedAt])
}

model ReadingSignoff {
  id                 String   @id @default(cuid())
  challengeId        String?
  accountId          String
  signoffDatePst     String
  bookTitle          String
  pagesRead          Int
  minutesRead        Int
  didWanikaniReviews Boolean  @default(false)
  reviewsLeft        Int
  apprenticeCount    Int
  currentWkLevel     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([accountId, signoffDatePst])
  @@index([challengeId, accountId])
  @@index([signoffDatePst])
  @@index([accountId])
}

model ReadingSignoffEntry {
  id                   String   @id @default(cuid())
  challengeId          String?
  accountId            String
  signoffDatePst       String
  bookTitle            String
  pagesRead            Int
  minutesRead          Int
  didWanikaniReviews   Boolean  @default(false)
  reviewWorkDone       Int      @default(0)
  reviewCorrect        Int      @default(0)
  reviewIncorrect      Int      @default(0)
  reviewSuccessPercent Int?
  createdAt            DateTime @default(now())

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([challengeId, accountId, signoffDatePst])
  @@index([accountId, signoffDatePst])
  @@index([accountId, createdAt])
  @@index([signoffDatePst])
}

model ReadingChallengeBook {
  id             String   @id @default(cuid())
  challengeId    String?
  accountId      String
  isbn           String
  title          String
  thumbnailUrl   String?
  manualCoverUrl String?
  infoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([accountId, isbn, challengeId])
  @@index([challengeId, accountId])
  @@index([accountId])
}

model ReadingChallengeMember {
  id          String   @id @default(cuid())
  challengeId String?
  accountId   String
  tracked     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([challengeId, accountId])
  @@index([challengeId, accountId])
  @@index([accountId])
}

model CustomStudyLibrary {
  id             String                @id @default(cuid())
  accountId      String
  externalKey    String
  name           String
  description    String?
  schemaVersion  Int                   @default(1)
  sourceType     CustomStudySourceType @default(json_upload)
  itemCount      Int                   @default(0)
  isActive       Boolean               @default(false)
  lastImportedAt DateTime              @default(now())
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  account        Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items          CustomStudyItem[]
  states         CustomStudyState[]
  reviewAttempts CustomStudyReviewAttempt[]

  @@unique([accountId, externalKey])
  @@index([accountId, isActive])
