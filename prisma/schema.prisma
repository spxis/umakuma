model SchoolGradeKanji {
  id             String   @id @default(cuid())
  kanji          String   @unique
  grade          Int
  category       String   @default("elementary")
  categoryName   String?
  categoryAbbr   String?
  strokeCount    Int?
  frequencyRank  Int?
  unicodeHex     String?
  primaryMeaning String?
  meanings       String[] @default([])
  onReadings     String[] @default([])
  kunReadings    String[] @default([])
  nanoriReadings String[] @default([])
  heisigKeyword  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([grade])
  @@index([category])
}

model WkSubjectCatalog {
  wkSubjectId               Int       @id
  object                    String    @default("subject")
  subjectType               String
  level                     Int
  slug                      String?
  characters                String?
  documentUrl               String?
  dataUpdatedAt             DateTime
  hiddenAt                  DateTime?
  meanings                  Json?
  readings                  Json?
  componentSubjectIds       Int[]     @default([])
  amalgamationSubjectIds    Int[]     @default([])
  visuallySimilarSubjectIds Int[]     @default([])
  meaningMnemonic           String?
  meaningHint               String?
  readingMnemonic           String?
  readingHint               String?
  rawData                   Json
  documentVersion           Int       @default(1)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([subjectType, level])
  @@index([level])
  @@index([dataUpdatedAt])
  @@index([hiddenAt])
}

/**
 * Admin-editable settings that are not simply on or off.
 * FeatureFlag holds booleans; this holds the rest, as strings parsed by the
 * definition in code. Same split as the flags: what settings exist and what
 * they accept lives in `src/lib/signupSettings.ts`, and the database stores
 * only the chosen values, so a setting works before any row exists and a stale
 * row for a removed setting is inert.
 */
model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WkCatalogSyncState {
  id                             String              @id @default("global")
  isSyncing                      Boolean             @default(false)
  syncLockUntil                  DateTime?
  nextSyncAllowedAt              DateTime            @default(now())
  lastStatus                     WkCatalogSyncStatus @default(idle)
  lastError                      String?
  lastFullSyncStartedAt          DateTime?
  lastFullSyncCompletedAt        DateTime?
  lastIncrementalSyncStartedAt   DateTime?
  lastIncrementalSyncCompletedAt DateTime?
  lastCursorDataUpdatedAt        DateTime?
  lastCursorSubjectId            Int?
  lastRunStats                   Json?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
}

model WkCatalogSyncRun {
  id                      String               @id @default(cuid())
  runType                 WkCatalogSyncRunType
  status                  WkCatalogSyncStatus  @default(running)
  startedAt               DateTime             @default(now())
  completedAt             DateTime?
  durationMs              Int?
  cursorFromDataUpdatedAt DateTime?
  cursorFromSubjectId     Int?
  cursorToDataUpdatedAt   DateTime?
  cursorToSubjectId       Int?
  fetchedCount            Int                  @default(0)
  upsertedCount           Int                  @default(0)
  changedCount            Int                  @default(0)
  errorCount              Int                  @default(0)
  errorMessage            String?
  stats                   Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([runType, startedAt])
  @@index([status, startedAt])
}

enum StudyReviewResult {
  correct
  wrong
  skipped
}

enum WkCatalogSyncStatus {
  idle
  running
  ok
  error
}

enum WkCatalogSyncRunType {
  full
  incremental
}

enum SubjectReviewSnapshotSource {
  sync
  ondemand
  submit
}

enum GameRunStatus {
  active
  completed
  abandoned
}

enum GameSubjectCategory {
  radical
  kanji
  vocabulary
  mixed
}

enum GameAnswerType {
  reading
  meaning
  chain
  romaji
}

/// Which side of the pair the player picks: the glyph (find) or its text (read).
enum GameDirection {
  find
  read
}

enum GameKind {
  match
  daily
  revenge
  time_attack
  shiritori
  map
}

enum ReadingChallengeStatus {
  draft
  active
  completed
  archived
}

enum CustomStudySourceType {
  json_upload
}

enum CustomStudyItemType {
  kanji
  vocabulary
  phrase
}

model ReadingChallenge {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String
  status        ReadingChallengeStatus @default(draft)
  currencyCode  String                 @default("JPY")
  startDatePst  String
  goalDatePst   String
  tripDatePst   String
  targetBaseYen Int
  scoringRules  Json
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  signoffs       ReadingSignoff[]
  signoffEntries ReadingSignoffEntry[]
  books          ReadingChallengeBook[]
  members        ReadingChallengeMember[]

  @@index([status])
  @@index([startDatePst, goalDatePst])
}

model StudyReviewAttempt {
  id           String            @id @default(cuid())
  accountId    String
  assignmentId Int
  subjectId    Int
  subjectType  String
  result       StudyReviewResult
  submittedAt  DateTime          @default(now())

  @@index([accountId, subjectId, submittedAt])
  @@index([accountId, submittedAt])
}

model GameRun {
  id               String              @id @default(cuid())
  accountId        String
  kind             GameKind            @default(match)
  batchSize        Int
  level            Int?
  category         GameSubjectCategory
  hardMode         Boolean             @default(false)
  choiceCount      Int                 @default(2)
  direction        GameDirection       @default(find)
  answerMode       String              @default("auto")
  dailyKey         String?
  seed             String?
  timeLimitMs      Int?
  questionCount    Int
  answeredCount    Int                 @default(0)
  correctCount     Int                 @default(0)
  currentStreak    Int                 @default(0)
  bestStreak       Int                 @default(0)
  score            Int                 @default(0)
  durationMs       Int?
  status           GameRunStatus       @default(active)
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  completedDatePst String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  questions GameQuestion[]

  @@unique([accountId, kind, dailyKey])
  @@index([accountId, completedAt])
  @@index([status, batchSize, level, category, completedDatePst])
  @@index([kind, status, completedDatePst])
}

model GameQuestion {
  id                String         @id @default(cuid())
  runId             String
  position          Int
  targetSubjectId   Int
  leftSubjectId     Int
  middleSubjectId   Int?
  rightSubjectId    Int
  optionSubjectIds  Int[]          @default([])
  answerType        GameAnswerType
  promptOverride    String?
  selectedSubjectId Int?
  correct           Boolean?
  answeredAt        DateTime?

  run GameRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId])
}

model StudySubjectTag {
  id        String   @id @default(cuid())
  accountId String
  subjectId Int
  favorite  Boolean  @default(false)
  trouble   Boolean  @default(false)
  /// Known so well it need never be read again; hidden from every list when the member says so.
  burned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, subjectId])
  @@index([accountId, favorite])
  @@index([accountId, trouble])
  @@index([accountId, burned])
}

/// A named set of characters a member built by hand: "Week 1", "Week 2".
///
/// Characters rather than WaniKani subject ids, which is the one place this
/// differs from StudySubjectTag. A list is built on whatever surface the member
/// was looking at, and the school-grade catalogue holds kanji WaniKani does not
/// teach - keying on subject id would silently drop those from a list that
/// visibly contained them. What a list holds is its `items`, each named the
/// way its own catalogue names it, with the subject id beside it where
/// WaniKani has one.
model StudyList {
  id            String                 @id @default(cuid())
  accountId     String
  name          String
  /// The old shape: a string of characters. Nothing reads it since 0.240.0;
  /// every list's characters were copied into `items` on 2026-09-02, with a
  /// snapshot in backups/. Dropping the column is a separate, deliberate
  /// `db:push` once John says so.
  characters    String[]
  /// A line under the name, for a list that is shared.
  description   String?
  visibility    StudyListVisibility    @default(private)
  /// Unguessable, for an unlisted list: the link carries it as `?key=`.
  shareToken    String?
  /// Whether anyone may add to it, or only the owner.
  contributions StudyListContributions @default(closed)
  archivedAt    DateTime?
  /// Where a copy came from, so it can say so and pull what was added since.
  sourceListId  String?
  /// A live list this was copied from - "jlpt:n5" - when the source was a system list.
  sourceLiveKey String?
  copyCount     Int                    @default(0)
  shareCount    Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items         StudyListItem[]
  subscriptions StudyListSubscription[]
  proposals     StudyListProposal[]

  /// One name per member, so saving "Week 1" twice updates rather than forks.
  @@unique([accountId, name])
  @@index([accountId, updatedAt])
  @@index([visibility, updatedAt])
  @@index([shareToken])
}

enum StudyListVisibility {
  private
  unlisted
  public
}

enum StudyListContributions {
  closed
  open
}

/// A member keeping somebody else's list, or a live one, read-only and current.
model StudyListSubscription {
  id        String   @id @default(cuid())
  accountId String
  listId    String?
  /// A live system list - "jlpt:n5", "grade:1", "wk:12" - when there is no row to point at.
  liveKey   String?
  createdAt DateTime @default(now())

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  list    StudyList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([accountId, listId])
  @@unique([accountId, liveKey])
  @@index([listId])
}

enum StudyListProposalAction {
  add
  remove
}

enum StudyListProposalStatus {
  pending
  approved
  declined
}

/// A change somebody who is not the owner would like made to a locked list.
model StudyListProposal {
  id        String                  @id @default(cuid())
  listId    String
  accountId String
  action    StudyListProposalAction
  kind      StudyListItemKind
  key       String
  subjectId Int?
  note      String?
  status    StudyListProposalStatus @default(pending)
  createdAt DateTime                @default(now())
  decidedAt DateTime?

  list    StudyList @relation(fields: [listId], references: [id], onDelete: Cascade)
  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([listId, status])
  @@index([accountId])
}

enum StudyListItemKind {
  radical
  kanji
  vocabulary
  sentence
}

/// One thing in a saved list, with its kind.
///
/// A list was a string of characters, so it could only hold kanji and a word
/// added to it became its kanji. An item carries what it is: the key names it
/// the way its own catalogue does - the characters for a kanji or a word, the
/// WaniKani slug for a radical, Tatoeba's id for a sentence - and the subject
/// id rides along where WaniKani names it, so tags and SRS state can be found
/// without a second lookup. A kanji WaniKani does not teach has no subject id
/// and is still an item, which is what keying on characters was protecting.
model StudyListItem {
  id               String            @id @default(cuid())
  listId           String
  kind             StudyListItemKind
  key              String
  subjectId        Int?
  /// The member's order, which is the list. Gaps are fine; only the ordering counts.
  position         Int
  /// Why it is here, in the words of whoever added it.
  note             String?
  addedByAccountId String?
  createdAt        DateTime          @default(now())

  list StudyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, kind, key])
  @@index([listId, position])
}

model SubjectReviewStatsSnapshot {
  id                   String                      @id @default(cuid())
  accountId            String
  subjectId            Int
  subjectType          String
  meaningCorrect       Int
  meaningIncorrect     Int
  meaningCurrentStreak Int
  meaningMaxStreak     Int
  readingCorrect       Int
  readingIncorrect     Int
  readingCurrentStreak Int
  readingMaxStreak     Int
  percentageCorrect    Int
  capturedAt           DateTime                    @default(now())
  source               SubjectReviewSnapshotSource @default(ondemand)

  @@index([accountId, subjectId, capturedAt])
  @@index([accountId, capturedAt])
}

model ReadingSignoff {
  id                 String   @id @default(cuid())
  challengeId        String?
  accountId          String
  signoffDatePst     String
  bookTitle          String
  pagesRead          Int
  minutesRead        Int
  didWanikaniReviews Boolean  @default(false)
  reviewsLeft        Int
  apprenticeCount    Int
  currentWkLevel     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([accountId, signoffDatePst])
  @@index([challengeId, accountId])
  @@index([signoffDatePst])
  @@index([accountId])
}

model ReadingSignoffEntry {
  id                   String   @id @default(cuid())
  challengeId          String?
  accountId            String
  signoffDatePst       String
  bookTitle            String
  pagesRead            Int
  minutesRead          Int
  didWanikaniReviews   Boolean  @default(false)
  reviewWorkDone       Int      @default(0)
  reviewCorrect        Int      @default(0)
  reviewIncorrect      Int      @default(0)
  reviewSuccessPercent Int?
  createdAt            DateTime @default(now())

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([challengeId, accountId, signoffDatePst])
  @@index([accountId, signoffDatePst])
  @@index([accountId, createdAt])
  @@index([signoffDatePst])
}

model ReadingChallengeBook {
  id             String   @id @default(cuid())
  challengeId    String?
  accountId      String
  isbn           String
  title          String
  thumbnailUrl   String?
  manualCoverUrl String?
  infoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([accountId, isbn, challengeId])
  @@index([challengeId, accountId])
  @@index([accountId])
}

model ReadingChallengeMember {
  id          String   @id @default(cuid())
  challengeId String?
  accountId   String
  tracked     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge ReadingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([challengeId, accountId])
  @@index([challengeId, accountId])
  @@index([accountId])
}

model CustomStudyLibrary {
  id             String                @id @default(cuid())
  accountId      String
  externalKey    String
  name           String
  description    String?
  schemaVersion  Int                   @default(1)
  sourceType     CustomStudySourceType @default(json_upload)
  itemCount      Int                   @default(0)
  isActive       Boolean               @default(false)
  lastImportedAt DateTime              @default(now())
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  account        Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items          CustomStudyItem[]
  states         CustomStudyState[]
  reviewAttempts CustomStudyReviewAttempt[]

  @@unique([accountId, externalKey])
  @@index([accountId, isActive])
}

model CustomStudyItem {
  id              Int                 @id @default(autoincrement())
  libraryId       String
  externalId      String
  itemType        CustomStudyItemType
  wkLevel         Int                 @default(1)
  characters      String
  meanings        String[]
  readings        String[]            @default([])
  primaryReading  String?
  meaningMnemonic String?
  readingMnemonic String?
  synonyms        String[]            @default([])
  notes           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  library        CustomStudyLibrary         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  states         CustomStudyState[]
  reviewAttempts CustomStudyReviewAttempt[]

  @@unique([libraryId, externalId])
  @@index([libraryId, itemType])
  @@index([libraryId, wkLevel])
}

model CustomStudyState {
  id             Int       @id @default(autoincrement())
  accountId      String
  libraryId      String
  itemId         Int
  srsStage       Int       @default(0)
  availableAt    DateTime?
  unlockedAt     DateTime?
  startedAt      DateTime?
  passedAt       DateTime?
  burnedAt       DateTime?
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account        Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  library        CustomStudyLibrary         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  item           CustomStudyItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reviewAttempts CustomStudyReviewAttempt[]

  @@unique([accountId, itemId])
  @@index([accountId, libraryId, srsStage, availableAt])
  @@index([accountId, libraryId, updatedAt])
}

model CustomStudyReviewAttempt {
  id               String            @id @default(cuid())
  accountId        String
  libraryId        String
  stateId          Int
  itemId           Int
  result           StudyReviewResult
  previousSrsStage Int?
  newSrsStage      Int?
  submittedAt      DateTime          @default(now())

  account Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  library CustomStudyLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  state   CustomStudyState   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  item    CustomStudyItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([accountId, libraryId, submittedAt])
  @@index([accountId, itemId, submittedAt])
}

/// Example sentences from Tatoeba, ingested from their weekly export.
///
/// The site's own sentences come from WaniKani, which means members without a
/// WaniKani connection see none at all. This is the source that answers "how is
/// this actually used" for everybody: 232,770 Japanese sentences that have an
/// English translation, indexed by the characters they contain.
///
/// Kept in Postgres rather than shipped as JSON like the kanji dictionary,
/// because a quarter of a million sentences is far past what belongs in a
/// bundle, and because the lookup is a containment query rather than a read.
model TatoebaSentence {
  /// Tatoeba's own id, so a row can link back to the sentence it came from.
  id         Int      @id
  japanese   String
  english    String
  /// Distinct kanji in the sentence; the GIN index is what makes 水 find these.
  kanji      String[] @default([])
  /// Lowest first: sentence length plus the cost of its hardest character.
  difficulty Int
  /// The contributor, for the attribution CC BY asks for.
  owner      String?
  ingestedAt DateTime @default(now())

  @@index([kanji], type: Gin)
  @@index([difficulty])
}

/// A request typed into the site, before it is real work.
///
/// The release timeline is `src/data/featureTimeline.json`, a file in the
/// repository. An agent can add to it with `pnpm backlog add` and commit the
/// change; the running site cannot write to it at all, and would lose anything
/// it did write on the next deploy. So a wish typed on the admin page lands
/// here instead, and `pnpm backlog wishes` is where an agent reads it.
///
/// Filing records the timeline id rather than moving the row, so the wish and
/// the entry it became stay linked and nothing is lost when the answer is no.
model FeatureWish {
  id          String            @id @default(cuid())
  title       String
  detail      String?
  /// The area, when whoever asked already knows it. Validated against
  /// FEATURE_AREA_VALUES at the boundary, not by the database, because areas
  /// are a TypeScript union that changes with the code.
  area        String?
  kind        String            @default("feature")
  status      FeatureWishStatus @default(open)
  /// The `featureTimeline.json` id an agent filed this as.
  filedAs     String?
  /// Who asked, by the email they were signed in as.
  requestedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
}

enum FeatureWishStatus {
  /// Waiting for an agent to pick it up.
  open
  /// An agent turned it into a planned timeline entry; `filedAs` says which.
  filed
  /// Answered no, kept on the record rather than deleted.
  declined
}
