/// Example sentences from Tatoeba, ingested from their weekly export.
///
/// The site's own sentences come from WaniKani, which means members without a
/// WaniKani connection see none at all. This is the source that answers "how is
/// this actually used" for everybody: 232,770 Japanese sentences that have an
/// English translation, indexed by the characters they contain.
///
/// Kept in Postgres rather than shipped as JSON like the kanji dictionary,
/// because a quarter of a million sentences is far past what belongs in a
/// bundle, and because the lookup is a containment query rather than a read.
model TatoebaSentence {
  /// Tatoeba's own id, so a row can link back to the sentence it came from.
  id         Int      @id
  japanese   String
  english    String
  /// Distinct kanji in the sentence; the GIN index is what makes 水 find these.
  kanji      String[] @default([])
  /// Lowest first: sentence length plus the cost of its hardest character.
  difficulty Int
  /// The contributor, for the attribution CC BY asks for.
  owner      String?
  ingestedAt DateTime @default(now())

  @@index([kanji], type: Gin)
  @@index([difficulty])
}

/// A request typed into the site, before it is real work.
///
/// The release timeline is `src/data/featureTimeline.json`, a file in the
/// repository. An agent can add to it with `pnpm backlog add` and commit the
/// change; the running site cannot write to it at all, and would lose anything
/// it did write on the next deploy. So a wish typed on the admin page lands
/// here instead, and `pnpm backlog wishes` is where an agent reads it.
///
/// Filing records the timeline id rather than moving the row, so the wish and
/// the entry it became stay linked and nothing is lost when the answer is no.
model Ticket {
  id          String       @id @default(cuid())
  title       String
  detail      String?
  /// The area, when whoever asked already knows it. Validated against
  /// FEATURE_AREA_VALUES at the boundary, not by the database, because areas
  /// are a TypeScript union that changes with the code.
  area        String?
  kind        String       @default("feature")
  status      TicketStatus @default(open)
  /// The `featureTimeline.json` id an agent filed this as.
  filedAs     String?
  /// Who asked, by the email they were signed in as.
  requestedBy String?
  /// The agent holding this task, and since when.
  ///
  /// Claims live here rather than in `featureTimeline.json` because a claim in
  /// the file is invisible to every other session until it reaches main, and
  /// is destroyed by the usual way a conflict on that file gets resolved -
  /// take main's copy, lose your row. A claim is the one thing that has to be
  /// true for everybody the instant it is made.
  claimedBy   String?
  claimedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([claimedBy])
  /**
   * The table keeps its old name on purpose. `prisma db push` does not rename
   * a table - it drops the old one and creates the new - so a physical rename
   * here would take every ticket with it. The model is what the code reads and
   * that is what needed to say `Ticket`; the table can be renamed later by a
   * deliberate SQL migration, or never, at no cost to anybody.
   */
  @@map("FeatureWish")
}

/// Where a ticket is in its life.
///
/// Values are added, never renamed: a Postgres enum member cannot be changed
/// under rows that already use it, and `filed` is what the first version of
/// this board wrote. It now means the same as `open` - work described and not
/// started - and nothing new is written with it.
enum TicketStatus {
  /// In the backlog. Nobody is on it.
  open
  /// An agent holds it. `claimedBy` says who and `claimedAt` when, which is
  /// what makes an abandoned hold reclaimable rather than permanent.
  in_progress
  /// Shipped. `filedAs` names the `featureTimeline.json` entry that records it.
  shipped
  /// The first board's word for open. Kept for the rows that already say it.
  filed
  /// Answered no, kept on the record rather than deleted.
  declined

  @@map("FeatureWishStatus")
}

/// The curriculum itself: one row per item on the UmaKuma ladder.
///
/// The ladder is built into `src/data/kanjiLadder.json` by a script, and that
/// file stays the source of truth for what the curriculum *is*. This table is
/// what the running site reads, so an admin can move an item and have members
/// see it before the next rebuild — and so a member's SRS state has something
/// stable to point at. `pnpm ladder:seed` makes the two agree; `ladder:check`
/// says when they do not.
///
/// Not a `CustomStudyLibrary`: that model is owned by one account, deletes
/// items missing from a re-import, and cascades their progress away with them.
/// A curriculum everybody shares cannot be rebuilt by deleting people's work.
model UkSubject {
  id              Int             @id @default(autoincrement())
  kind            UkSubjectKind
  /// Stable business key: `kanji:語`, `radical:口`, `wk:2467`, `word:苺`.
  key             String          @unique
  characters      String
  /// Ours, 1-100.
  level           Int
  /// Set where WaniKani teaches the same item, so their content can be reused.
  wkSubjectId     Int?            @unique
  source          UkSubjectSource
  nLevel          Int?
  schoolGrade     Int?
  /// Only for items WaniKani does not teach; the rest read from the catalogue.
  meanings        String[]        @default([])
  readings        String[]        @default([])
  /// Ours to write. Never WaniKani's, which is their copyrighted text.
  meaningMnemonic String?
  readingMnemonic String?
  notes           String?
  /// Soft, so a member's progress survives an item being pulled and restored.
  removedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  states      UkSrsState[]
  radicalLink UkRadicalLink?

  @@index([kind, level])
  @@index([level])
  @@index([removedAt])
}

/// Every add, move and remove an admin has made to the ladder, in order.
///
/// Append-only on purpose. A resolved map of "where everything ended up" loses
/// who moved it, when and why, and cannot say which op a rebuild refused. The
/// build replays these over the computed ladder, so a move survives
/// `pnpm ladder:refresh` instead of being silently undone by it.
model LadderOverride {
  id               String        @id @default(cuid())
  op               LadderOpType
  kind             UkSubjectKind
  key              String
  fromLevel        Int?
  toLevel          Int?
  /// For an add: the characters, meanings and readings the item ships with.
  payload          Json?
  reason           String?
  /// The admin's email, so the log answers "who".
  by               String
  createdAt        DateTime      @default(now())
  /// Set once the op has been written into the committed overrides file.
  exportedAt       DateTime?
  /// Set once a curriculum version has shipped carrying it.
  appliedInVersion String?

  @@index([createdAt])
  @@index([exportedAt])
  @@index([key])
}

enum UkSubjectKind {
  radical
  kanji
  vocabulary
}

/// Where an item's facts come from. Must stay equal to `LADDER_SOURCES` in
/// `src/lib/ladder/ladderCrosswalk.ts`, which a test enforces: two lists of the
/// same domain values drift, and no test over either one notices.
enum UkSubjectSource {
  /// WaniKani teaches it; their catalogue holds the content.
  wanikani
  /// Jōyō that WaniKani skips; KANJIDIC2 holds the content.
  kanjidic
  /// One of RADKFILE's classical radicals, which WaniKani does not use.
  radkfile
  /// Added by an admin, so the content is on the row.
  admin
}

enum LadderOpType {
  move
  add
  remove
}

/// How a member arrived at the level they start on.
enum UkPlacementSource {
  placement_test
  wanikani
  self
  admin
}

/// Why a state row exists. A row seeded by a placement test is not the same
/// evidence as one a member earned by answering, and the profile says so.
/// The two orderings UmaKuma teaches the same subjects in: UK is the exam
/// ladder, UG the Japanese school one. Ours, both of them, which is why they
/// carry a version and WaniKani's levels do not.
enum LadderStream {
  UK
  UG
}

enum UkStateOrigin {
  lesson
  placement
  wanikani
  bump
  admin
}

/// One member's progress on one curriculum item.
///
/// Rows are created lazily — at a lesson, a placement seed or a WaniKani
/// import — so "no row" means locked. The custom-study stack creates every row
/// at import; at 9,271 items per member that is the wrong default here.
///
/// `srsStage` is the same 0-9 scale WaniKani uses, deliberately, so a member
/// arriving with forty levels of their progress keeps every interval rather
/// than restarting at zero.
model UkSrsState {
  id             Int           @id @default(autoincrement())
  accountId      String
  subjectId      Int
  srsStage       Int           @default(0)
  availableAt    DateTime?
  unlockedAt     DateTime?
  startedAt      DateTime?
  passedAt       DateTime?
  /// Not terminal. A member may pull a burned item back down when they want
  /// more review, which is why our top rung is named for mastery rather than
  /// for retirement.
  burnedAt       DateTime?
  lastReviewedAt DateTime?
  reviewCount    Int           @default(0)
  correctCount   Int           @default(0)
  wrongCount     Int           @default(0)
  origin         UkStateOrigin @default(lesson)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subject  UkSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attempts UkReviewAttempt[]

  @@unique([accountId, subjectId])
  @@index([accountId, srsStage, availableAt])
  @@index([accountId, updatedAt])
}

/// One answer, kept. The state row holds where a member is; this holds how
/// they got there, which is what a history page and a trouble list read.
model UkReviewAttempt {
  id                String            @id @default(cuid())
  accountId         String
  stateId           Int
  subjectId         Int
  result            StudyReviewResult
  previousSrsStage  Int?
  newSrsStage       Int?
  submittedAt       DateTime          @default(now())
  /// Which of our two ladders the member was following when they answered.
  /// Null on every attempt recorded before there were two, which were all UK.
  curriculumStream  LadderStream?
  /// The curriculum version this answer was given against - not the site's
  /// release number, which answers a different question. We move the ladder
  /// when the evidence says to, and an answer given against one arrangement of
  /// levels should still be readable after the arrangement changes. Null on
  /// attempts recorded before the stamp existed, which were all 1.0.0.
  curriculumVersion String?

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  state   UkSrsState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([accountId, submittedAt])
  @@index([accountId, subjectId, submittedAt])
}

/// How a pair was established, so a hand-made link is not silently recomputed.
enum UkRadicalMatch {
  /// The two write the same character. 196 of our 241 pair this way.
  character
  /// Decided by a person, where the shapes correspond but the characters do not.
  manual
}

/// One of our radicals beside WaniKani's radical for the same shape.
///
/// A nullable `UkSubject.wkSubjectId` could carry the pointer, and did, but it
/// cannot carry the thing that makes this worth having: **the two names**.
/// WaniKani calls 一 "Ground", 月 "Moon" and ハ "Fins"; RADKFILE and KANJIDIC
/// call them "one", "month" and nothing at all. Both are useful and they are
/// not interchangeable — a member who learned the shape as Fins should be able
/// to find it as Fins, and a member who never used WaniKani should never be
/// shown a name we did not write.
///
/// That last point is the reason the names live in a row rather than being
/// read live from the catalogue: WaniKani's radical names are their own
/// invention and their content. Holding them in a table we control is what
/// lets `canSeeWanikaniContent` gate them the way it gates their mnemonics,
/// instead of the gate being spread across every surface that joins.
///
/// It also gives the mismatch somewhere to live. Our name for 冂 is
/// "upside-down box radical (no. 13)", which is the dictionary's own
/// bookkeeping rather than a name; theirs is "Head". A row where `ourName` is
/// null or reads like an index entry is a piece of content waiting to be
/// written, and now it is a query rather than a memory.
model UkRadicalLink {
  id          Int            @id @default(autoincrement())
  /// Our radical.
  ukSubjectId Int            @unique
  /// Theirs. Unique both ways: 476 of their radicals carry a character and no
  /// character is used twice, so the pairing is genuinely one to one.
  wkSubjectId Int            @unique
  /// The shape both sides agree on, denormalised so a join is not needed to
  /// read the pair.
  characters  String
  /// Ours, from RADKFILE and KANJIDIC. Null where we have no name yet.
  ourName     String?
  /// WaniKani's. Their content: shown to connected members only.
  theirName   String
  matchedBy   UkRadicalMatch @default(character)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject UkSubject @relation(fields: [ukSubjectId], references: [id], onDelete: Cascade)

  @@index([characters])
}

/// A kind of XP that can be earned, and what it is worth.
///
/// A string on the event would have carried the pointer and nothing else. This
/// carries the two things a string cannot: **what it is worth**, so the
/// economy can be retuned without a deploy, and **a note saying what it is
/// for**, so a member reading "+50 XP" on their history has an answer to "for
/// what" that does not live in a developer's head.
///
/// The id is the same key the code uses (`dailySignIn`, `reviewCorrect`), so
/// the constants in `xpAwards.ts` and these rows are the same vocabulary
/// rather than two lists that drift. A test holds them equal, which is the
/// lesson from the Prisma enum that lacked `radkfile` and silently failed
/// every radical at seed.
///
/// There is no flag saying whether a kind is a "bonus". A streak milestone and
/// a review answered are both simply kinds of XP that can be earned, and a
/// boolean dividing them would have been a second way of saying what the
/// amount and the note already say.
model XpType {
  /// Matches the key in XP_AWARDS.
  id        String    @id
  /// What a member reads on their history.
  label     String
  /// Why it exists, in a sentence, for the same reader.
  note      String
  amount    Int
  /// Most XP a day of this kind may be worth. Null means uncapped, which is
  /// deliberate for reviews: capping study means telling somebody their work
  /// stopped counting.
  dailyCap  Int?
  /// Set the first time an admin prices this kind from the site. Once set,
  /// `xp:types:seed` stops overwriting the amount, cap, label and note - the
  /// constants say which kinds exist, and a decision made here outranks the
  /// number a developer typed. Without this the next seed would silently undo
  /// every tuning decision.
  pricedAt  DateTime?
  /// Retired kinds keep their rows, so old events still explain themselves.
  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events XpEvent[]
}

/// One kind of XP earned on one day, accumulated.
///
/// A row per award would have been the obvious shape and is wrong: the unique
/// index below would then reject the second review of a day, since reviews are
/// earned dozens of times. So a row holds a day's *total* for one kind and is
/// incremented, which makes both jobs one read - a daily cap is the row's
/// amount, and a once-a-day award is a row that already exists.
///
/// `dayKey` is the Vancouver day, the same boundary Daily Challenge uses.
model XpEvent {
  id        String   @id @default(cuid())
  accountId String
  /// References XpType.id. Named `kind` because that is what the code calls it
  /// and a persisted field is not renamed for tidiness.
  kind      String
  amount    Int
  dayKey    String
  /// What this particular award was for, where the type's own note is not
  /// specific enough - "a 30-day streak", "level 20, N4 complete". Null for
  /// the routine kinds, whose type note says everything there is to say.
  note      String?
  /// When the first award of this kind landed on this day.
  createdAt DateTime @default(now())
  /// When the last one did. The row accumulates, so these two bracket the
  /// day's earning rather than timing a single award - fifty reviews are one
  /// row, and this says when the first and last of them were answered.
  ///
  /// That is the trade the accumulating shape makes: a daily cap becomes one
  /// read and a once-a-day award becomes a row that exists, at the cost of not
  /// timing each award individually. If per-award timing is ever wanted, the
  /// answer is a second table of awards rather than exploding this one, since
  /// the cap logic depends on the daily total being a single row.
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type    XpType  @relation(fields: [kind], references: [id])

  @@unique([accountId, kind, dayKey])
  @@index([accountId, createdAt])
}

/// Why a day with no study still counted.
enum MemberRestKind {
  /// Spent automatically after the fact, to keep a streak alive.
  rest
  /// A planned absence. Freezes the SRS as well as the streak.
  vacation
}

/// Days off an admin handed over, on top of what the rank earns.
///
/// A row rather than a column on the account, and additive rather than an
/// override, for three reasons that all point the same way.
///
/// **Additive** because "extra" is what was asked for. An override column
/// would replace the derived allowance, so a member granted twenty days at
/// rank 5 would still have twenty at rank 50 — the grant would quietly become
/// a cap, and the member would be opted out of every future retune of the
/// rules. A grant that sits on top composes with the ladder instead of
/// replacing it.
///
/// **A row** because the allowance is a rolling-year allowance: usage is
/// counted over the last 365 days, so a grant counted the same way lives in
/// the same time model as everything around it. A permanent integer column
/// would drift out of that model — after two years a member with a standing
/// +7 has had fourteen days of latitude while the screen still says seven.
/// Rows also compose (three small grants are three rows), revoke by deletion,
/// and carry the audit that a column cannot: which admin, when, and why.
///
/// Not a `MemberRest` row of a third kind. That table means "a day the member
/// was away", keyed `@@unique([accountId, dayKey])`; a grant is not a day and
/// has no day key, so storing one there would mean inventing keys that could
/// collide with real days off.
model MemberRestGrant {
  id        String         @id @default(cuid())
  accountId String
  /// Which allowance this tops up. The same enum the usage rows use, so there
  /// is no second list of kinds to drift from the first.
  kind      MemberRestKind
  /// Whole days added. Positive only: taking latitude back from somebody who
  /// may already have booked against it is a different act, and the way to
  /// undo a grant is to delete the row.
  days      Int
  /// Why, for the admin reading it back in a month. Never shown to the member.
  note      String?
  /// Which admin, by email. The audit the XP grants have not got.
  grantedBy String?
  createdAt DateTime       @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

/// One day a member was away and not penalised for it.
///
/// A row per day rather than a period with two ends, for the same reason the
/// streak is derived from days that exist: the streak calculation asks "was
/// this day covered", and a row per day answers it directly instead of by
/// arithmetic over ranges that can overlap, invert, or be left open by a
/// process that died halfway.
///
/// A vacation writes its whole span up front, so the days are covered even if
/// nothing runs again until the member returns.
model MemberRest {
  id        String         @id @default(cuid())
  accountId String
  /// Vancouver day, the same key XpEvent uses.
  dayKey    String
  kind      MemberRestKind
  /// Groups the days of one vacation, so it can be described and cancelled as
  /// the single decision it was.
  periodId  String?
  createdAt DateTime       @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dayKey])
  @@index([accountId, kind])
  @@index([periodId])
}

enum LevelTestKind {
  /// Written, not passed. Opens the level whatever the score.
  checkpoint
  /// Must be passed. Levels 10, 20, 35, 50 and 100 certify N5 through N1.
  jlpt_final
}

enum LevelTestVerdict {
  solid
  passed
  nearly
  not_yet
}

/// One sitting of a level test.
///
/// The questions, answers and scoring all live in `GameRun` with kind
/// `level_test`, so the runner, the answer route, the Corners board and the
/// results panel are the ones already built and tested. This row holds the
/// things a run cannot: which gate it stands at, whether it must be passed,
/// which attempt it is, and what the verdict was.
///
/// `curriculumVersion` is recorded because a test is a claim about a
/// curriculum. If the ladder moves, a pass sat on version 1.2 should still say
/// what it was a pass *of* rather than silently becoming a claim about
/// material the member never saw.
model LevelTest {
  id                String            @id @default(cuid())
  accountId         String
  kind              LevelTestKind
  /// `jlpt:3` or `check:15`. Stable, so an attempt can be found by its gate.
  gateKey           String
  attempt           Int               @default(1)
  level             Int
  questionCount     Int
  /// Percent needed. Zero where the test only has to be written.
  threshold         Int
  mustPass          Boolean
  answeredCount     Int               @default(0)
  correctCount      Int               @default(0)
  verdict           LevelTestVerdict?
  /// The GameRun this was played on, where one was used.
  runId             String?
  curriculumVersion String
  startedAt         DateTime          @default(now())
  completedAt       DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, gateKey, attempt])
  @@index([accountId, gateKey])
  @@index([accountId, completedAt])
}
