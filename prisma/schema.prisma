generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String    @id @default(cuid())
  nickname                 String
  /**
   * The address, and the name, which are not the same thing.
   * `slug` is unique and permanent: it is in every link anyone has shared, so
   * renaming must not touch it. `displayName` is what people read, anyone can
   * change it, and two members may share one. Both are nullable while existing
   * accounts are still routed by wkUsername.
   */
  slug                     String?   @unique
  displayName              String?
  /**
   * JLPT certification, as the member reports it.
   * Self-declared, unlike wkLevel which WaniKani decides. The system matters
   * as much as the level: the test was restructured in 2010 and both schemes
   * count down, so an old Level 4 is the beginner certificate and maps to N5,
   * not N4. Stored as given and converted for display.
   */
  jlptStatus               String?
  /**
   * The single certificate a member used to be allowed.
   * A member may hold several - somebody who sat N5, then N4, then N3 holds
   * three - so what they have passed lives in `JlptCertificate` rows now, and
   * these three columns are the answer given before that table existed. They
   * were migrated into rows and nothing reads them; they are kept because the
   * data outlives the code, not because anything still asks. `jlptStatus`
   * above is still live: it carries the states that are not a certificate at
   * all - studying, planning to sit, none, rather not say.
   */
  jlptSystem               String?
  jlptLevel                Int?
  jlptYear                 Int?
  /**
   * Who may see this member, and whether they are let in at all.
   * `visibility` is the member's own choice, asked during signup and editable
   * on their profile: private, family (other members) or public. Null means an
   * account that predates the column, which was already on the leaderboard and
   * must stay there, so it reads as family rather than private.
   * `approvalStatus` is John's decision, not theirs. Open Google signup lets
   * anyone create an account, but it stays pending until approved, so a
   * stranger can look around without appearing anywhere.
   */
  visibility               String?
  approvalStatus           String?
  approvedAt               DateTime?
  joinedByEmail            String?
  joinedByName             String?
  inviteCodeHash           String?
  inviteCodeUpdatedAt      DateTime?
  /**
   * The WaniKani connection, which an account may not have.
   * Identity is the account; this is a link on it. All six move together -
   * a half-connected account is not a state worth modelling, so code should
   * test one of them (the token) and treat the rest as present or absent with
   * it. Nullable `wkUserId` keeps its unique index: Postgres does not compare
   * nulls, so any number of unconnected accounts coexist.
   */
  tokenEncrypted           String?
  tokenIv                  String?
  tokenTag                 String?
  wkUserId                 String?   @unique
  wkUsername               String?
  wkLevel                  Int?
  reviewCount              Int       @default(0)
  burnedCount              Int       @default(0)
  pendingReviews           Int       @default(0)
  radicalCount             Int       @default(0)
  vocabularyCount          Int       @default(0)
  apprenticeCount          Int       @default(0)
  guruCount                Int       @default(0)
  masterCount              Int       @default(0)
  enlightenedCount         Int       @default(0)
  levelKanjiTotal          Int       @default(0)
  levelKanjiLearned        Int       @default(0)
  levelKanjiGuruPlus       Int       @default(0)
  levelKanjiLocked         Int       @default(0)
  estimatedHoursRemaining  Int?
  levelKanjiItems          Json?
  itemSpread               Json?
  jlptCounts               Json?
  assignmentCache          Json?
  assignmentCacheUpdatedAt DateTime?
  reviewsUpdatedAt         DateTime?
  lastRadicalGuruedAt      DateTime?
  lastKanjiGuruedAt        DateTime?
  lastVocabularyGuruedAt   DateTime?
  lastRadicalGuruedItem    Json?
  lastKanjiGuruedItem      Json?
  lastVocabularyGuruedItem Json?
  wkHttpCache              Json?
  lastActivityAt           DateTime?
  isSyncing                Boolean   @default(false)
  syncLockUntil            DateTime?
  nextSyncAllowedAt        DateTime  @default(now())
  lastSyncStatus           String    @default("idle")
  lastSyncError            String?
  score                    Int       @default(0)
  lastSyncedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customStudyLibraries      CustomStudyLibrary[]
  customStudyStates         CustomStudyState[]
  customStudyReviewAttempts CustomStudyReviewAttempt[]
  studySubjectTags          StudySubjectTag[]
  /// One of us: the family and anybody let in deliberately. Decides who is
  /// offered the reading challenge and its check-ins, which are not public.
  internal                  Boolean                    @default(false)
  jlptCertificates          JlptCertificate[]
  studyLists                StudyList[]
  studyListSubscriptions    StudyListSubscription[]
  studyListProposals        StudyListProposal[]
  gameRuns                  GameRun[]
}

/// One JLPT certificate a member reports holding.
///
/// A row rather than three columns on the account, because a member may hold
/// several: the ladder is meant to be climbed, and somebody who sat N5, N4 and
/// N3 has three certificates rather than a current one. The year decides the
/// system - the test was restructured in 2010 - and it is stored beside the
/// level so a row reads on its own without consulting the year twice.
model JlptCertificate {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "classic" (1984-2009, levels 4-1) or "modern" (2010 on, N5-N1).
  system    String
  level     Int
  year      Int
  createdAt DateTime @default(now())

  /// The same level in the same year is the same certificate, not a second one.
  @@unique([accountId, system, level, year])
  @@index([accountId])
}

model InviteRateLimit {
  key       String   @id
  attempts  Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model LevelSnapshot {
  id                      String   @id @default(cuid())
  accountId               String
  level                   Int
  kanjiTotal              Int      @default(0)
  kanjiLearned            Int      @default(0)
  kanjiGuruPlus           Int      @default(0)
  kanjiLocked             Int      @default(0)
  estimatedHoursRemaining Int?
  items                   Json?
  syncedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([accountId, level])
  @@index([accountId])
}

model DailyAccountSnapshot {
  id                String    @id @default(cuid())
  accountId         String
  snapshotDatePst   String
  snapshotAt        DateTime  @default(now())
  wkLevel           Int
  reviewCount       Int
  burnedCount       Int
  pendingReviews    Int
  radicalCount      Int
  vocabularyCount   Int
  apprenticeCount   Int
  guruCount         Int
  masterCount       Int
  enlightenedCount  Int
  levelKanjiLearned Int
  levelKanjiTotal   Int
  score             Int
  lastActivityAt    DateTime?
  lastSyncedAt      DateTime

  @@unique([accountId, snapshotDatePst])
  @@index([accountId])
}

model JlptKanji {
  id             String    @id @default(cuid())
  kanji          String    @unique
  nLevel         Int
  strokeCount    Int?
  frequencyRank  Int?
  schoolGrade    Int?
  heisigKeyword  String?
  unicodeHex     String?
  sourceJlpt     Int?
  primaryMeaning String?
  meanings       String[]  @default([])
  onReadings     String[]  @default([])
  kunReadings    String[]  @default([])
  nanoriReadings String[]  @default([])
  notes          String[]  @default([])
  wordExamples   Json?
  enrichedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nLevel])
