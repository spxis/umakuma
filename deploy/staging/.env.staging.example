# Example only — placeholders, never real values.
#
# The real file lives ONLY on DS1 at:
#   /volume2/docker/staging/umakuma/.env.staging   (chmod 600)
# and is created/updated by deploy-staging-ds1.sh. Nothing secret belongs in
# this repo.

# Neon production connection string (DIRECT_URL from the app's .env).
# Used read-only, by pg_dump.
NEON_DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Password for the staging postgres superuser. Generated on DS1 by the deploy
# script; alphanumeric so it needs no URL-encoding.
POSTGRES_PASSWORD=REPLACE_ME

# Host port the staging db publishes on. See ../../deploy/staging/README.md and
# the port table in the DS1 staging root README.
STAGING_DB_PORT=55432

# Nightly refresh time, DS1-local, and how many dumps to retain.
REFRESH_CRON=30 3 * * *
DUMP_KEEP=14
TZ=America/Los_Angeles

# DS15 dump replication (nightly, after the refresh).
DS15_HOST=10.0.0.115
DS15_USER=spxis
DS15_PATH=/volume1/docker/staging/umakuma/dumps
REPLICATE_CRON=15 4 * * *
